<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lvactivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#dfdfdf"
    android:orientation="vertical"
    tools:context= ".Views.ProdutoActivity">


    <Space
        android:layout_width="wrap_content"
        android:layout_height="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <ImageView
            android:id="@+id/iv_produto"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="12dp"
            android:elevation="30dp"
            android:src="@drawable/wa500x500" />

        <TextView
            android:id="@+id/tv_descricao_pdc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="120dp"
            android:layout_marginTop="10dp"
            android:elevation="20dp"
            android:text="@string/designacao_activity"
            android:textColor="@android:color/black"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_pontos_pdc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="120dp"
            android:layout_marginTop="40dp"
            android:elevation="10dp"
            android:paddingEnd="10dp"
            android:text="@string/preco_produto"
            android:textColor="@android:color/black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_quantidade_pdc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="120dp"
            android:layout_marginTop="60dp"
            android:elevation="20dp"
            android:text="@string/quantidade_produto"
            android:textColor="@android:color/black"
            android:textSize="12sp" />


    </FrameLayout>


</LinearLayout>