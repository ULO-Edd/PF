<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".Views.MyInfoActivity">

    <TextView
        android:id="@+id/tv_my_Name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="55dp"
        android:backgroundTint="#72000000"
        android:hint="@string/register_Name"
        android:lines="1"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#72000000"
        android:textColorHint="#72000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="-8dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:background="#72000000"/>

    <TextView
        android:id="@+id/tv_my_LastName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="55dp"
        android:backgroundTint="#72000000"
        android:text="@string/register_Apelido"
        android:lines="1"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#72000000"
        android:textColorHint="#72000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="-8dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:background="#72000000"/>

    <TextView
        android:id="@+id/tv_my_Bday"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="55dp"
        android:backgroundTint="#72000000"
        android:text="@string/register_DataNascimento"
        android:lines="1"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#72000000"
        android:textColorHint="#72000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="-8dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:background="#72000000"/>

    <EditText
        android:id="@+id/et_my_Username"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="55dp"
        android:backgroundTint="#000000"
        android:hint="@string/register_Username"
        android:lines="1"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <EditText
        android:id="@+id/et_my_Email"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="55dp"
        android:backgroundTint="#000000"
        android:hint="@string/register_Email"
        android:lines="1"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <EditText
        android:id="@+id/et_my_Telephone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="55dp"
        android:backgroundTint="#000000"
        android:hint="@string/register_Telephone"
        android:lines="1"
        android:maxLines="1"
        android:phoneNumber="true"
        android:singleLine="true"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <Button
        android:id="@+id/btn_registar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="78dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="78dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#FFFFFF"
        android:text="@string/change_info"
        android:textColor="#000000"
        android:onClick="OnClickChangeMyInfo"
        app:strokeColor="#FFC107"
        app:strokeWidth="3.5dp" />

</LinearLayout>